{
  "name": "spikeclip",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:api": "pnpm --filter @spikeclip/api dev",
    "dev:web": "pnpm --filter @spikeclip/web dev",
    "build:api": "pnpm --filter @spikeclip/api build",
    "build:web": "pnpm --filter @spikeclip/web build",
    "build:shared": "pnpm --filter @spikeclip/shared build",
    "start:api": "pnpm --filter @spikeclip/api start",
    "start:web": "pnpm --filter @spikeclip/web start",
    "test:api": "pnpm --filter @spikeclip/api test",
    "test:web": "pnpm --filter @spikeclip/web test",
    "test:shared": "pnpm --filter @spikeclip/shared test",
    "test:e2e": "pnpm --filter @spikeclip/api test:e2e",
    "prisma:migrate": "pnpm --filter @spikeclip/api prisma:migrate",
    "prisma:seed": "pnpm --filter @spikeclip/api prisma:seed",
    "prisma:studio": "pnpm --filter @spikeclip/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.10.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
